# ---------------------------------------------------------------------------
# Modele de configuration. `cp .env.example .env` puis renseigner.
#
# En production (docker-compose.prod.yml), NODE_ENV, TZ, DATABASE_PATH et
# BACKUP_DIR sont imposes par le compose et ecrasent ce qui est ici : ils
# decrivent l'interieur du conteneur, pas un choix d'exploitation.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# URL publique exacte, sans slash final. Deux usages :
#  - construire les magic links : si elle ne correspond pas a ce que voit le
#    navigateur, les liens de connexion pointeront au mauvais endroit ;
#  - alimenter ORIGIN cote adapter-node (le compose de production s'en charge).
#    Sans ORIGIN, la verification CSRF compare l'origine annoncee par le
#    navigateur a une origine reconstituee en http:// depuis l'en-tete Host du
#    reverse proxy : elles different et tous les formulaires renvoient 403.
#   production : https://prono.tyvia.eu
#   dev local  : http://localhost:5173
PUBLIC_BASE_URL=https://pronos.example.eu

# Fuseau de reference des crons et de la cloture des semaines.
TZ=Europe/Brussels

# Port d'ecoute du serveur node.
PORT=3000

# OBLIGATOIRE EN PRODUCTION. >= 32 caracteres. Sert au HMAC des jetons de
# session et des magic links, qui ne sont jamais stockes en clair.
# Le changer deconnecte tout le monde et invalide les magic links en vol.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=changez-moi-avec-une-chaine-aleatoire-de-64-caracteres

# ---------------------------------------------------------------------------
# Base de donnees et sauvegardes
# ---------------------------------------------------------------------------
# Chemins vus depuis le conteneur. En dev local, mettre ./data/nfl.db et
# ./backup — un chemin absolu /data n'existe pas hors conteneur.
DATABASE_PATH=/data/nfl.db
BACKUP_DIR=/backup

# Retention des sauvegardes ecrites par le cron interne de l'application.
# Le script de sauvegarde de l'hote a sa propre retention (30 jours).
BACKUP_KEEP=14

# ---------------------------------------------------------------------------
# Saison
# ---------------------------------------------------------------------------
# Saison interrogee chez ESPN. Modifiable aussi dans /admin (season.year).
SEASON_YEAR=2026

# ---------------------------------------------------------------------------
# SMTP (magic links)
# ---------------------------------------------------------------------------
# Sans SMTP_HOST, les liens sont ecrits dans les logs du conteneur au lieu
# d'etre envoyes : pratique en dev, inutilisable pour de vrais joueurs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pronos NFL <pronos@example.eu>"

# ---------------------------------------------------------------------------
# Amorcage : ce compte est cree en admin au premier demarrage s'il n'existe pas
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PSEUDO=admin

# ---------------------------------------------------------------------------
# Crons (laisser vide pour les valeurs par defaut de la spec)
# ---------------------------------------------------------------------------
# CRON_SNAPSHOT=0 9 * * 3
# CRON_RESULTS=*/15 * * * 0,1,4,5,6
# CRON_CLOSE=0 9 * * 2
# CRON_BACKUP=30 4 * * *
# CRON_REMINDER=0 8 * * 4
# Mettre a 0 pour desactiver totalement l'ordonnanceur (utile en dev).
CRON_ENABLED=1

# ---------------------------------------------------------------------------
# Mode simulation (developpement et recette uniquement)
# ---------------------------------------------------------------------------
# MOCK_ESPN=1 debloque, dans /admin, la creation d'une semaine de simulation :
# quatre matchs fictifs dont les kickoffs tombent a +5, +10, +15 et +20 minutes,
# avec des scores qui progressent d'un quart-temps toutes les 2 min 30 avant de
# passer en final. De quoi verifier le verrouillage au kickoff, l'apparition des
# pronostics des autres joueurs et le calcul des points en une demi-heure.
#
# La valeur doit valoir exactement 1 : absente, vide ou differente, aucun match
# fictif ne peut entrer en base et le poll ignore les semaines de simulation
# deja creees. **A laisser hors de la production.**
#
# Pour voir les scores avancer sans cliquer, raccourcir le poll :
#   CRON_RESULTS=* * * * *
# MOCK_ESPN=1
