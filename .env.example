# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# URL publique, utilisee pour construire les magic links (sans slash final)
PUBLIC_BASE_URL=https://pronos.example.eu
# Fuseau de reference pour les crons et la cloture des semaines
TZ=Europe/Brussels
# Port d'ecoute du serveur node
PORT=3000
# Obligatoire en production : secret utilise pour hacher les jetons (>= 32 caracteres)
AUTH_SECRET=changez-moi-avec-une-chaine-aleatoire-de-64-caracteres

# ---------------------------------------------------------------------------
# Base de donnees
# ---------------------------------------------------------------------------
DATABASE_PATH=/data/nfl.db
# Repertoire des sauvegardes quotidiennes (copie coherente via VACUUM INTO)
BACKUP_DIR=/backup
BACKUP_KEEP=14

# ---------------------------------------------------------------------------
# Saison
# ---------------------------------------------------------------------------
SEASON_YEAR=2026

# ---------------------------------------------------------------------------
# SMTP (magic links). Si SMTP_HOST est vide, les liens sont ecrits dans les logs.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pronos NFL <pronos@example.eu>"

# ---------------------------------------------------------------------------
# Amorcage : ce compte est cree en admin au premier demarrage s'il n'existe pas
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PSEUDO=admin

# ---------------------------------------------------------------------------
# Crons (laisser vide pour utiliser les valeurs par defaut de la spec)
# ---------------------------------------------------------------------------
# CRON_SNAPSHOT=0 9 * * 3
# CRON_RESULTS=*/15 * * * 0,1,4,5,6
# CRON_CLOSE=0 9 * * 2
# CRON_BACKUP=30 4 * * *
# CRON_REMINDER=0 8 * * 4
# Mettre a 0 pour desactiver totalement l'ordonnanceur (utile en dev)
CRON_ENABLED=1
